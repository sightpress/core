{#
    Show / hide a section with the native <details> element: works without JavaScript, by keyboard (Enter or
    Space on the summary), and screen readers say whether it is expanded.

        {% import 'partials/disclosure.html.twig' as disclosure %}
        {% set answer %}<p>{{ t('We keep it for 30 days.') }}</p>{% endset %}
        {{ disclosure.details(t('What happens to my data?'), answer) }}

    `content` is HTML the caller has already escaped, such as a `{% set %}…{% endset %}` capture.
#}
{% macro details(summary, content, options = {}) %}
    <details class="disclosure"{% if options.open|default(false) %} open{% endif %}>
        <summary>{{ summary }}</summary>
        <div class="disclosure__content">{{ content }}</div>
    </details>
{%- endmacro %}
