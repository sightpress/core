{#
    SVG icons drawn inline, so they need no request and follow the text colour:

        {% import 'partials/icons.html.twig' as icons %}
        {{ icons.icon('info') }}                    decorative: hidden from screen readers
        {{ icons.icon('external', t('opens in a new tab')) }}   meaningful: role="img" with a name

    An icon is never the only way to tell something: put a visible word next to it, or give it a name.
#}
{% macro icon(name, label = null) %}
    {%- set paths = {
        'info': 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 4.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM10.5 11h2.5v6.5h-2v-4.5h-.5Z',
        'success': 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.2-4-4 1.4-1.4 2.6 2.6 5.4-5.4 1.4 1.4Z',
        'warning': 'M12 2 1 21h22L12 2Zm-1 7h2v6h-2V9Zm0 8h2v2h-2v-2Z',
        'error': 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1 5h2v7h-2V7Zm0 9h2v2h-2v-2Z',
        'close': 'M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19l5.6-5.6 5.6 5.6 1.4-1.4-5.6-5.6L19 6.4 17.6 5 12 10.6Z',
        'chevron-left': 'M15.4 5.4 14 4l-8 8 8 8 1.4-1.4L8.8 12Z',
        'chevron-right': 'M8.6 5.4 10 4l8 8-8 8-1.4-1.4 6.6-6.6Z',
        'external': 'M14 3h7v7h-2V6.4l-9.3 9.3-1.4-1.4L17.6 5H14V3ZM5 5h6v2H5v12h12v-6h2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z',
    } -%}
    {%- if label is empty -%}
    <svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="{{ paths[name] }}"/></svg>
    {%- else -%}
    <svg class="icon" viewBox="0 0 24 24" width="24" height="24" role="img" aria-label="{{ label }}" focusable="false"><path fill="currentColor" d="{{ paths[name] }}"/></svg>
    {%- endif -%}
{% endmacro %}
