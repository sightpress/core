{#
    A search form (SR-2): a <search> landmark named by its visible label, a search input named "q" and a visible
    "Search" button, sent with GET. Without JavaScript it works the same.

        {% include 'partials/search-form.html.twig' with {action: '/search', query: 'river', id: 'search'} only %}

    Context: `action` (required: where it searches), `query` (optional: fills the input), `id` (optional, "search" by
    default: the start of its ids, so a page can have two), `label` (optional, "Search this site" by default).
#}
{%- set id = id|default('search') -%}
<search class="search-form" aria-labelledby="{{ id }}-label">
    <form method="get" action="{{ action }}">
        <label id="{{ id }}-label" for="{{ id }}-q">{{ label|default(t('Search this site')) }}</label>
        <span class="search-form__row">
            <input id="{{ id }}-q" type="search" name="q" value="{{ query|default('') }}" maxlength="200" enterkeyhint="search">
            <button type="submit" class="button">{{ t('Search') }}</button>
        </span>
    </form>
</search>
