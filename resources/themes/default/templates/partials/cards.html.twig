{#
    A card: a heading with one link (the whole card is clickable, but there is only one link to tab to and read),
    then a short text. Put cards in a list so screen readers say how many there are:

        {% import 'partials/cards.html.twig' as cards %}
        <ul class="cards">
            <li>{{ cards.card({title: 'Opening hours', href: '/hours', text: 'When we are open.'}) }}</li>
        </ul>

    `level` sets the heading level (2 by default) so the outline stays in order.
#}
{% macro card(card) %}
    {%- set level = card.level|default(2) -%}
    <article class="card">
        <h{{ level }} class="card__title"><a href="{{ card.href }}">{{ card.title }}</a></h{{ level }}>
        {%- if card.text is defined and card.text is not empty %}
        <p>{{ card.text }}</p>
        {%- endif %}
    </article>
{%- endmacro %}
