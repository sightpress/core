{#
    Links to the pages of a long list: "Previous" and "Next" in words, the current page marked with
    aria-current="page", and gaps ("…") hidden from screen readers.

        {% import 'partials/pagination.html.twig' as pagination %}
        {{ pagination.nav(2, 10, '/news?page=%d', t('News pages')) }}

    `url` is a pattern with `%d` for the page number; `label` names the navigation landmark.
#}
{% macro nav(current, total, url, label) %}
    {%- if total > 1 -%}
    {%- import 'partials/icons.html.twig' as icons -%}
    <nav class="pagination" aria-label="{{ label }}">
        <ul>
            {%- if current > 1 %}
            <li><a href="{{ url|format(current - 1) }}" rel="prev">{{ icons.icon('chevron-left') }}{{ t('Previous') }}<span class="visually-hidden"> {{ t('page') }}</span></a></li>
            {%- endif %}
            {%- set shown = [1, current - 1, current, current + 1, total]|filter(n => n >= 1 and n <= total)|reduce((carry, n) => n in carry ? carry : carry|merge([n]), []) %}
            {%- set previous = 0 %}
            {%- for n in shown|sort %}
            {%- if n > previous + 1 %}
            <li aria-hidden="true">…</li>
            {%- endif %}
            <li>
                {%- if n == current -%}
                <a href="{{ url|format(n) }}" aria-current="page"><span class="visually-hidden">{{ t('Page') }} </span>{{ n }}</a>
                {%- else -%}
                <a href="{{ url|format(n) }}"><span class="visually-hidden">{{ t('Page') }} </span>{{ n }}</a>
                {%- endif -%}
            </li>
            {%- set previous = n %}
            {%- endfor %}
            {%- if current < total %}
            <li><a href="{{ url|format(current + 1) }}" rel="next">{{ t('Next') }}<span class="visually-hidden"> {{ t('page') }}</span>{{ icons.icon('chevron-right') }}</a></li>
            {%- endif %}
        </ul>
    </nav>
    {%- endif -%}
{%- endmacro %}
