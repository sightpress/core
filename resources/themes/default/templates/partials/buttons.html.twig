{#
    Buttons and links that look like buttons. Use a <button> for actions and a link for going somewhere.

        {% import 'partials/buttons.html.twig' as buttons %}
        {{ buttons.button(t('Save')) }}
        {{ buttons.button(t('Delete page'), {variant: 'danger', type: 'submit'}) }}
        {{ buttons.link(t('Read the guide'), '/guide', {variant: 'secondary'}) }}

    Variants: `primary` (default), `secondary`, `danger`. Every button is at least 44 by 44 CSS pixels.
#}
{% macro button(text, options = {}) %}
    {%- set variant = options.variant|default('primary') -%}
    <button type="{{ options.type|default('button') }}" class="button button--{{ variant }}"
        {%- if options.name is defined %} name="{{ options.name }}"{% endif %}
        {%- if options.value is defined %} value="{{ options.value }}"{% endif %}>{{ text }}</button>
{%- endmacro %}

{% macro link(text, href, options = {}) %}
    <a class="button button--{{ options.variant|default('primary') }}" href="{{ href }}">{{ text }}</a>
{%- endmacro %}
