{#
    A message box: `info`, `success`, `warning` or `error`. The type is said in words (the title, or a hidden
    "Error:" … prefix), never only by colour or icon. Alerts that are on the page when it loads are not live
    regions; set `live: true` only when a script adds the alert later.

        {% import 'partials/alerts.html.twig' as alerts %}
        {{ alerts.alert('success', t('Page published'), t('Visitors can see it now.')) }}
#}
{% macro alert(type, title, text = null, options = {}) %}
    {%- import 'partials/icons.html.twig' as icons -%}
    {%- set prefixes = {info: t('Information:'), success: t('Success:'), warning: t('Warning:'), error: t('Error:')} -%}
    <div class="alert alert--{{ type }}"{% if options.live|default(false) %} role="{{ type == 'error' ? 'alert' : 'status' }}"{% endif %}>
        {{ icons.icon(type) }}
        <div class="alert__body">
            <p class="alert__title"><span class="visually-hidden">{{ prefixes[type] }} </span>{{ title }}</p>
            {%- if text is not empty %}
            <p>{{ text }}</p>
            {%- endif %}
        </div>
    </div>
{%- endmacro %}
