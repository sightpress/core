{#
    A data table with a caption and header cells. On narrow screens it scrolls sideways inside a labelled region
    that can be focused, so keyboard users can scroll it too (the rest of the page still reflows at 320 px).

        {% import 'partials/tables.html.twig' as tables %}
        {{ tables.table('Opening hours', ['Day', 'Opens', 'Closes'], [['Monday', '9:00', '17:00']], {row_headers: true}) }}

    With `row_headers`, the first cell of each row is a row header; `id` sets the caption's id.
#}
{% macro table(caption, headers, rows, options = {}) %}
    {%- set id = options.id|default('table-' ~ random()) -%}
    <div class="table-wrap" role="region" aria-labelledby="{{ id }}" tabindex="0">
        <table>
            <caption id="{{ id }}">{{ caption }}</caption>
            <thead>
                <tr>
                    {%- for header in headers %}
                    <th scope="col">{{ header }}</th>
                    {%- endfor %}
                </tr>
            </thead>
            <tbody>
                {%- for row in rows %}
                <tr>
                    {%- for cell in row %}
                    {%- if loop.first and options.row_headers|default(false) %}
                    <th scope="row">{{ cell }}</th>
                    {%- else %}
                    <td>{{ cell }}</td>
                    {%- endif %}
                    {%- endfor %}
                </tr>
                {%- endfor %}
            </tbody>
        </table>
    </div>
{%- endmacro %}
