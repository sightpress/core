{#
    Site search's results (SR-2): the title as the only <h1> (what was searched for and how many results there are,
    which is also the page's <title>, so screen readers announce both when the page loads), the search form, then the
    results as a numbered list. Each result has its title as a link in an <h2>, where it is on the site, and an
    extract whose matched words are in <mark>. Nothing was found, nothing was searched for yet, or too many searches:
    the page says so in words, with tips.

    Context: `title`, `query`, `action` (where the form searches), `state` ("results", "none", "empty" or "busy"),
    `total`, `first` (the number of the first result on this page), `matched_all` (false when no page has every
    word), `results` (list of {title, url, excerpt, locale, trail, extract: list of {text, mark}}), `pagination`
    ({current, pages, previous, next, pattern} or null), `language_name`, `retry_minutes` (when busy).
#}
{% extends 'master.html.twig' %}
{% import 'partials/pagination.html.twig' as pages %}
{% block title %}{{ title }}{% endblock %}
{% block main %}
<div class="container container--narrow search-page">
    <h1>{{ title }}</h1>
    {% include 'partials/search-form.html.twig' with {action: action, query: query, id: 'search', label: t('Search for')} only %}
    {% block content %}
    {%- if state == 'busy' %}
    <p>{{ t('You have searched many times in a short while. Wait {minutes, plural, one {# minute} other {# minutes}}, then search again.', {minutes: retry_minutes}) }}</p>
    {%- elseif state == 'results' %}
    {%- if not matched_all %}
    <p class="search-note">{{ t('No page has every word you searched for, so these pages have some of them.') }}</p>
    {%- endif %}
    <ol class="search-results" start="{{ first }}">
        {%- for result in results %}
        <li class="search-result">
            <h2 class="search-result__title"><a href="{{ result.url }}">{{ result.title }}</a></h2>
            {%- if result.trail %}
            <p class="search-result__trail"><span class="visually-hidden">{{ t('In:') }} </span>{{ result.trail }}</p>
            {%- endif %}
            {%- if result.extract is not empty %}
            <p class="search-result__extract">{% for piece in result.extract %}{% if piece.mark %}<mark>{{ piece.text }}</mark>{% else %}{{ piece.text }}{% endif %}{% endfor %}</p>
            {%- endif %}
        </li>
        {%- endfor %}
    </ol>
    {%- if pagination %}
    {{ pages.nav(pagination.current, pagination.pages, pagination.pattern, t('Search results pages')) }}
    {%- endif %}
    {%- else %}
    {%- if state == 'empty' %}
    <p>{{ t('Type one or more words, then choose Search.') }}</p>
    {%- endif %}
    <h2>{{ t('Tips') }}</h2>
    <ul class="search-tips">
        <li>{{ t('Check the spelling of each word.') }}</li>
        <li>{{ t('Try fewer words, or other words that mean the same.') }}</li>
        <li>{{ t('You can type the start of the last word: “librar” also finds “library”.') }}</li>
        {%- if languages is defined and languages is not empty %}
        <li>{{ t('This searches the pages in {language}. To search in another language, choose it in the list of languages.', {language: language_name}) }}</li>
        {%- endif %}
    </ul>
    {%- endif %}
    {% endblock %}
</div>
{% endblock %}
