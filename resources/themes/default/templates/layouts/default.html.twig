{#
    Default layout: one column at a comfortable reading width, the page title as the only <h1>, then `content`.
    Context: `title` (required), `lead` (optional summary under the title), `updated_at` (optional, UTC: shown as
    "Last updated" under the content, in the reader's time zone and language).
#}
{% extends 'master.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block main %}
<div class="container container--narrow">
    <h1>{{ title }}</h1>
    {%- if lead is defined and lead is not empty %}
    <p class="lead">{{ lead }}</p>
    {%- endif %}
    {% block content %}{% endblock %}
    {%- if updated_at is defined and updated_at %}
    <p class="page-updated">{{ t('Last updated') }} <time datetime="{{ updated_at|date('Y-m-d\\TH:i:s\\Z', 'UTC') }}">{{ updated_at|user_date }}</time></p>
    {%- endif %}
</div>
{% endblock %}
