{#
    Page shell of every page the theme renders (WCAG 2.2 AA):

    - `lang` and `dir` come from `locale` (the page's language) or else the viewer's language;
    - a "Skip to main content" link is the first thing to tab to;
    - landmarks: <header> (banner), <nav aria-label> for each menu, <main id="content">, <footer> (content info);
    - flash `messages` sit at the top of <main> in a polite live region.

    Context (all optional): `site_name`, `branding_logo` ({url, alt, width, height}: an uploaded logo shown instead
    of the name), `locale`, `main_menu` and `footer_menu` (lists of {label, url, current,
    children}; up to three levels), `breadcrumbs` (list of {label, url}, the last one the current page; a null label is the home page, "Home"),
    `messages` (list of texts), `form` (its errors put "Error: " in front of the <title>), `document_title` (the
    whole <title>, set by the SEO module; otherwise the page's title and the site name).

    Submenus of the main menu are nested lists, all shown without JavaScript; js/site.js turns them into disclosure
    buttons ("Show the pages under About", `aria-expanded`), which Escape closes.
    Blocks: `title`, `head`, `brand`, `breadcrumbs`, `main`, `footer`, `scripts`.
#}
{%- set lang = locale|default(current_locale()) -%}
{%- set site_name = site_name|default('SightPress') -%}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ text_direction(lang) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{% if form is defined and form.errors is not empty %}{{ t('Error:') }} {% endif %}{% if document_title is defined and document_title %}{{ document_title }}{% else %}{% block title %}{% endblock %} - {{ site_name }}{% endif %}</title>
<link rel="stylesheet" href="{{ asset('tokens.css') }}">
<link rel="stylesheet" href="{{ asset('css/site.css') }}">
{% block head %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#content">{{ t('Skip to main content') }}</a>
<header class="site-header">
    <div class="container site-header__inner">
        {% block brand %}
        {%- if branding_logo is defined and branding_logo %}
        <a class="site-name site-name--logo" href="/"><img src="{{ branding_logo.url }}" alt="{{ branding_logo.alt }}" width="{{ branding_logo.width }}" height="{{ branding_logo.height }}"></a>
        {%- else %}
        <a class="site-name" href="/">{{ site_name }}</a>
        {%- endif %}
        {% endblock %}
        {%- if main_menu is defined and main_menu is not empty %}
        <nav class="menu menu--main" aria-label="{{ t('Main') }}" data-submenu-label="{{ t('Show the pages under') }}">
            {{ _self.menu(main_menu, 'main-menu') }}
        </nav>
        {%- endif %}
    </div>
</header>
{% block breadcrumbs %}
{%- if breadcrumbs is defined and breadcrumbs|length > 1 %}
<nav class="breadcrumbs" aria-label="{{ t('Breadcrumb') }}">
    <div class="container">
        <ol>
            {%- for crumb in breadcrumbs %}
            <li><a href="{{ crumb.url }}"{% if loop.last %} aria-current="page"{% endif %}>{{ crumb.label ?? t('Home') }}</a></li>
            {%- endfor %}
        </ol>
    </div>
</nav>
{%- endif %}
{% endblock %}
<main id="content" class="site-main" tabindex="-1">
    {% include 'partials/messages.html.twig' with {messages: messages|default([])} only %}
    {% block main %}{% endblock %}
</main>
<footer class="site-footer">
    <div class="container">
        {%- if footer_menu is defined and footer_menu is not empty %}
        <nav class="menu menu--footer" aria-label="{{ t('Footer') }}">
            {{ _self.menu(footer_menu, 'footer-menu') }}
        </nav>
        {%- endif %}
        {% block footer %}<p>{{ site_name }}</p>{% endblock %}
    </div>
</footer>
{% block scripts %}<script src="{{ asset('js/site.js') }}" defer></script>{% endblock %}
</body>
</html>
{% macro menu(items, id) %}
    <ul{% if id is not empty %} id="{{ id }}"{% endif %}>
        {%- for item in items %}
        <li><a href="{{ item.url }}"{% if item.current|default(false) %} aria-current="page"{% endif %}>{{ item.label }}</a>
            {%- if item.children|default([]) is not empty %}
            {{ _self.menu(item.children, id ~ '-' ~ loop.index) }}
            {%- endif %}</li>
        {%- endfor %}
    </ul>
{% endmacro %}
