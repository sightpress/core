{#
    Shell of every admin screen (ADR-0004, WCAG 2.2 AA):

    - the <title> names the screen, then "Admin" and the site; with form errors it starts with their number;
    - "Skip to main content" is the first thing to tab to;
    - landmarks: <header> (banner) with the site, the person's name, "My account" and "Sign out"; <nav aria-label="Admin"> with
      nested lists and aria-current="page" on the current screen; <main id="content">;
    - flash `messages` sit at the top of <main> in a polite live region.

    Screens extend this template and fill `title` and `content` (which starts with the screen's <h1>).
    Context from AdminScreens: `site_name`, `messages`, `admin_nav`, `admin_user_name`, `error_count`.
#}
{%- set lang = current_locale() -%}
<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ text_direction(lang) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="robots" content="noindex, nofollow">
<title>{% if error_count > 0 %}{{ error_count == 1 ? t('1 error:') : t('{count} errors:', {count: error_count}) }} {% endif %}{% block title %}{% endblock %} - {{ t('Admin') }} - {{ site_name }}</title>
<link rel="stylesheet" href="{{ asset('tokens.css') }}">
<link rel="stylesheet" href="{{ asset('css/site.css') }}">
<link rel="stylesheet" href="{{ asset('css/admin.css') }}">
{% block head %}{% endblock %}
</head>
<body class="admin">
<a class="skip-link" href="#content">{{ t('Skip to main content') }}</a>
<header class="site-header admin-header">
    <div class="admin-header__inner">
        <p class="admin-header__site"><a class="site-name" href="/">{{ site_name }}</a> <span class="admin-header__tag">{{ t('Admin') }}</span></p>
        <div class="admin-header__account">
            {%- if admin_user_name %}
            <p class="admin-header__user">{{ t('Signed in as {name}', {name: admin_user_name}) }}</p>
            {%- endif %}
            <a href="/account">{{ t('My account') }}</a>
            <form action="/logout" method="post">
                {{ csrf_fields() }}
                <button type="submit" class="button button--secondary">{{ t('Sign out') }}</button>
            </form>
        </div>
    </div>
</header>
<div class="admin-body">
    <nav class="admin-nav" aria-label="{{ t('Admin') }}">
        {{ _self.menu(admin_nav) }}
    </nav>
    <main id="content" class="site-main admin-main" tabindex="-1">
        {% include 'partials/messages.html.twig' with {messages: messages|default([])} only %}
        {% block content %}{% endblock %}
    </main>
</div>
{% block scripts %}<script src="{{ asset('js/site.js') }}" defer></script>{% endblock %}
</body>
</html>
{% macro menu(entries) %}
    <ul>
        {%- for entry in entries %}
        <li>
            <a href="{{ entry.url }}"{% if entry.current %} aria-current="page"{% endif %}>{{ t(entry.label) }}</a>
            {%- if entry.children is not empty %}
            {{ _self.menu(entry.children) }}
            {%- endif %}
        </li>
        {%- endfor %}
    </ul>
{% endmacro %}
