{#
    Site settings (/admin/settings): the site's name, its languages (with a link to change them) and time zone, then one fieldset per group of
    settings the modules registered (who runs the site, search & AI, others), and what can't be changed yet. One
    "Save settings" button; errors go to the error summary, which gets focus.
    Context: `form`, `action`, `sections` [{title, intro, fields}], `owner`, `languages` [{name, main}], `languages_path`,
    `sign_up_open`.
#}
{% extends '@admin/layout.html.twig' %}
{% import 'form/macros.html.twig' as f %}
{% block title %}{{ t('Site settings') }}{% endblock %}
{% block content %}
<h1>{{ t('Site settings') }}</h1>
<p>{{ t('The logo, icon and share picture are on their own page:') }} <a href="/admin/settings/branding">{{ t('Branding') }}</a>.</p>
<p>{{ sign_up_open ? t('Anyone can create an account.') : t('Only people you invite can join.') }} <a href="/admin/settings/sign-up">{{ t('Change who can sign up') }}</a></p>
{{ f.error_summary(form) }}
{{ f.start(form, action) }}
    <fieldset class="admin-panel">
        <legend>{{ t('The site') }}</legend>
        {{ f.field(form, 'name') }}
        <p>{{ t('Languages:') }}
            {%- for language in languages %} {{ language.main ? t('{language} (main language)', {language: language.name}) : t(language.name) }}{{ loop.last ? '.' : ',' }}{% endfor %}
            <a href="{{ languages_path }}">{{ t('Change the languages') }}</a></p>
        {{ f.field(form, 'timezone') }}
        {{ f.field(form, 'visibility') }}
        <p>{{ t('The site is run by {owner}.', {owner: t(owner)}) }}</p>
    </fieldset>
    {%- for section in sections %}
    <fieldset class="admin-panel">
        <legend>{{ t(section.title) }}</legend>
        {%- if section.intro %}<p>{{ t(section.intro) }}</p>{% endif %}
        {%- for name in section.fields %}
        {{ f.field(form, name) }}
        {%- endfor %}
    </fieldset>
    {%- endfor %}
    <section class="admin-panel" aria-labelledby="settings-later">
        <h2 id="settings-later">{{ t('Not yet changeable') }}</h2>
        <dl class="people-details">
            <dt>{{ t('Theme') }}</dt>
            <dd>{{ t('SightPress Default. More themes come in a later version.') }}</dd>
        </dl>
    </section>
    {{ f.submit(t('Save settings')) }}
{{ f.end() }}
{% endblock %}
