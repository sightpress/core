{% extends '@auth/layout.html.twig' %}
{% import 'form/macros.html.twig' as f %}
{% block title %}{{ t('Sign in') }}{% endblock %}
{% block content %}
<h1>{{ t('Sign in') }}</h1>
{{ f.error_summary(form) }}
{{ f.start(form, action) }}
    {{ f.field(form, 'email') }}
    {{ f.field(form, 'password') }}
    {{ f.field(form, 'remember') }}
    {{ f.submit(t('Sign in')) }}
{{ f.end() }}
{%- if sign_up|default(null) %}
<p>{{ t('New here?') }} <a href="{{ sign_up }}">{{ t('Create an account') }}</a></p>
{%- endif %}
<p><a href="/login/forgot">{{ t('Forgot your password?') }}</a></p>
<p><a href="/login/invitation">{{ t('Accept an invitation') }}</a></p>
<p><a href="/login/setup">{{ t('Set up your account with a setup code') }}</a></p>
{% endblock %}
