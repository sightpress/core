{#
    Page shell of the sign-in pages: the theme's master template (skip link, landmarks, flash messages in a polite
    live region) at a narrow width. Never indexed. Templates fill `title` and `main`.
#}
{% extends 'master.html.twig' %}
{% block head %}<meta name="robots" content="noindex">{% endblock %}
{% block main %}
<div class="container container--narrow">
{% block content %}{% endblock %}
</div>
{% endblock %}
