{#
    "Confirm your email address" (/register/code), like the other code pages: the person who signed up types the code we
    emailed them (the shared @auth/code-entry.html.twig form, with "Send a new code"). Never indexed.
    Context: `title`, `form`, `action`, `valid_for`, `start_again` (the sign-up form, or null when it is closed).
#}
{% extends '@auth/layout.html.twig' %}
{% block title %}{{ t(title) }}{% endblock %}
{% block content %}
<h1>{{ t(title) }}</h1>
<p>{{ t('If this address can be used for a new account, we have emailed it a 6-digit code. The code works for {duration}, and only once.', {duration: valid_for}) }}</p>
<p>{{ t('We never send links. Type the code here, on this site.') }}</p>
{% include '@auth/code-entry.html.twig' with {'submit': t('Confirm my email address'), 'resend': true} %}
{%- if start_again %}
<p><a href="{{ start_again }}">{{ t('Use another email address') }}</a></p>
{%- endif %}
<p><a href="/login">{{ t('Back to sign in') }}</a></p>
{% endblock %}
