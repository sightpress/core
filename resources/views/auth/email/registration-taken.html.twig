<!DOCTYPE html>
<html lang="{{ current_locale() }}" dir="{{ text_direction(current_locale()) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t(subject) }}</title>
</head>
<body style="margin:0;padding:24px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:18px;line-height:1.5;color:#1a1a1f;background:#ffffff;">
<p>{{ t('Hello {name},', {name: name}) }}</p>
<p>{{ t('Someone tried to sign up for {site} with your email address. You already have an account there, so nothing was changed and no new account was made.', {site: site_name}) }}</p>
<p>{{ t('If it was you, sign in with your email address and password. If you have forgotten your password, choose “Forgot your password?” on the sign-in page.') }}</p>
<p>{{ t('If it wasn’t you, you can ignore this email. Your account and your password stay as they are.') }}</p>
<p>{{ t('We never send links in our emails.') }}</p>
</body>
</html>
