<!DOCTYPE html>
<html lang="{{ current_locale() }}" dir="{{ text_direction(current_locale()) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t(subject) }}</title>
</head>
<body style="margin:0;padding:24px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:18px;line-height:1.5;color:#1a1a1f;background:#ffffff;">
<p>{{ t('Hello {name},', {name: name}) }}</p>
<p>{{ by_text ? t('The password of your account on {site} was just changed, after a code we sent to your mobile number.', {site: site_name}) : t('The password of your account on {site} was just changed.', {site: site_name}) }}</p>
<p>{{ t('If you made this change, you don’t need to do anything.') }}</p>
<p>{{ t('If you didn’t, choose “Forgot your password?” on the sign-in page of {site} to choose a new one, and contact the people who run it straight away.', {site: site_name}) }}</p>
<p>{{ t('We never send links in our emails.') }}</p>
</body>
</html>
