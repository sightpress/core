<!DOCTYPE html>
<html lang="{{ current_locale() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pending ? t('Your code to choose your password for {site}', {'site': site_name}) : t('Your code to reset your password for {site}', {'site': site_name}) }}</title>
</head>
<body style="margin: 0; padding: 1.5rem; font-family: system-ui, sans-serif; font-size: 18px; line-height: 1.5; color: #1a1a1a; background: #ffffff;">
<p>{{ t('Hello {name},', {'name': name}) }}</p>
{% if pending %}
<p>{{ t('Someone asked for a code to choose the password of your new account on {site}. Your code is:', {'site': site_name}) }}</p>
{% else %}
<p>{{ t('Someone asked to reset the password of your account on {site}. Your code is:', {'site': site_name}) }}</p>
{% endif %}
{% include '@auth/email/code.html.twig' %}
<p>{{ t('If you did not ask for this, you can ignore this email: nothing changes until the code is used.') }}</p>
</body>
</html>
