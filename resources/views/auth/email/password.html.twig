<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pending ? t('Choose your password for {site}', {'site': site_name}) : t('Reset your password for {site}', {'site': site_name}) }}</title>
</head>
<body style="margin: 0; padding: 1.5rem; font-family: system-ui, sans-serif; font-size: 18px; line-height: 1.5; color: #1a1a1a; background: #ffffff;">
<p>{{ t('Hello {name},', {'name': name}) }}</p>
{% if pending %}
<p>{{ t('Choose your password for {site} with this link:', {'site': site_name}) }}</p>
{% else %}
<p>{{ t('Someone asked to reset the password of your account on {site}. To choose a new password, open this link:', {'site': site_name}) }}</p>
{% endif %}
<p><a href="{{ link }}" style="color: #0b4f9c;">{{ pending ? t('Choose your password') : t('Choose a new password') }}</a></p>
<p>{{ t('The link works for {duration} and only once.', {'duration': valid_for}) }}</p>
{% if not pending %}
<p>{{ t('If you did not ask for this, you can ignore this email: your password stays the same.') }}</p>
{% endif %}
</body>
</html>
