<!DOCTYPE html>
<html lang="{{ current_locale() }}" dir="{{ text_direction(current_locale()) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t(subject) }}</title>
</head>
<body style="margin:0;padding:24px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:18px;line-height:1.5;color:#1a1a1f;background:#ffffff;">
<p>{{ t('Hello {name},', {name: name}) }}</p>
<p>{{ t('The email address of your account on {site} is now {email}. From now on you sign in with that address, and our emails go there.', {site: site_name, email: new_email}) }}</p>
<p>{{ t('If you made this change, you don’t need to do anything.') }}</p>
<p>{{ t('If you didn’t, someone else may know your password. Contact the people who run {site} straight away.', {site: site_name}) }}</p>
<p>{{ t('We never send links in our emails.') }}</p>
</body>
</html>
