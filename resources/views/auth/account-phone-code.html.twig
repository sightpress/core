{#
    "Confirm your mobile number" (/account/phone/code, N-3), like the other code pages: the shared
    @auth/code-entry.html.twig form, with "Send a new code". Never indexed.
    Context: `title`, `form`, `action`, `valid_for`.
#}
{% extends '@auth/layout.html.twig' %}
{% block title %}{{ t(title) }}{% endblock %}
{% block content %}
<h1>{{ t(title) }}</h1>
<p>{{ t('If this number can be used, we have sent it a 6-digit code by text message. The code works for {duration}, and only once.', {duration: valid_for}) }}</p>
<p>{{ t('We never send links. Type the code here, on this site.') }}</p>
{% include '@auth/code-entry.html.twig' with {'submit': t('Confirm my number'), 'resend': true, 'by_text': true} %}
<p><a href="/account/phone">{{ t('Use another number') }}</a></p>
<p><a href="/account">{{ t('Back to My account') }}</a></p>
{% endblock %}
