{#
    "Change your password" (/account/password), from My account: the current password, then the new one (the site's
    policy in its hint). Errors go to the error summary, which gets focus. Never indexed.
    Context: `title`, `form`, `email`, `action`.
#}
{% extends '@auth/layout.html.twig' %}
{% import 'form/macros.html.twig' as f %}
{% block title %}{{ t(title) }}{% endblock %}
{% block content %}
<h1>{{ t(title) }}</h1>
<p>{{ t('For the account {email}.', {'email': email}) }}</p>
<p>{{ t('You stay signed in here. Everywhere else, including devices where you chose “Keep me signed in”, you are signed out.') }}</p>
{{ f.error_summary(form) }}
{{ f.start(form, action) }}
    {{ f.field(form, 'current_password') }}
    {{ f.field(form, 'new_password') }}
    {{ f.submit(t('Change password')) }}
{{ f.end() }}
<p><a href="/account">{{ t('Back to My account') }}</a></p>
{% endblock %}
