{#
    One person in the admin (/admin/users/{id}): their details, their role and whether they can sign in. On your
    own account both are read-only. Context: `account`, `role`, `status`, `form`, `self`, `path`, `phone` (masked, or
    null; with "Remove mobile number", N-6).
#}
{% extends '@admin/layout.html.twig' %}
{% import 'form/macros.html.twig' as f %}
{% block title %}{{ account.effectiveName }}{% endblock %}
{% block content %}
<p><a href="/admin/users">{{ t('Back to people') }}</a></p>
<h1 class="people-heading">{% if account.avatarUrl %}<img class="avatar" src="{{ account.avatarUrl }}" alt="" width="48" height="48"> {% endif %}{{ account.effectiveName }}</h1>
<dl class="people-details">
    <dt>{{ t('Full name') }}</dt><dd>{{ account.fullName }}</dd>
    <dt>{{ t('Email address') }}</dt><dd>{{ account.email }}</dd>
    <dt>{{ t('Role') }}</dt><dd>{{ role ? t(role.label) : t('No role') }}</dd>
    <dt>{{ t('Status') }}</dt><dd>{{ t(status) }}</dd>
    {%- if phone %}
    <dt>{{ t('Mobile number') }}</dt><dd>{{ phone }}</dd>
    {%- endif %}
</dl>
{%- if self %}
<p>{{ t('This is your own account. You can’t change your own role or deactivate yourself; ask another admin.') }} <a href="/account">{{ t('Change your details in My account') }}</a></p>
{%- else %}
<section class="admin-panel" aria-labelledby="people-role-title">
    <h2 id="people-role-title">{{ t('Change role') }}</h2>
    {{ f.error_summary(form) }}
    {{ f.start(form, path) }}
        {{ f.field(form, 'role') }}
        {{ f.submit(t('Change role')) }}
    {{ f.end() }}
</section>
{%- if account.isUnverified %}
<p>{{ t('{name} signed up but hasn’t typed the code we emailed them yet, so they can’t sign in. If they don’t, the account is removed a week after they signed up.', {name: account.effectiveName}) }}</p>
{%- else %}
<section class="admin-panel" aria-labelledby="people-status-title">
    <h2 id="people-status-title">{{ account.isDeactivated ? t('Reactivate account') : t('Deactivate account') }}</h2>
    {%- if account.isDeactivated %}
    <p>{{ t('{name} can’t sign in. Reactivating lets them sign in again with their old password.', {name: account.effectiveName}) }}</p>
    {%- else %}
    <p>{{ t('{name} won’t be able to sign in, and is signed out straight away. Their pages stay. You can reactivate the account later.', {name: account.effectiveName}) }}</p>
    {%- endif %}
    <form action="{{ path }}/status" method="post">
        {{ csrf_fields() }}
        <button type="submit" class="button{{ account.isDeactivated ? '' : ' button--secondary' }}">{{ account.isDeactivated ? t('Reactivate {name}', {name: account.effectiveName}) : t('Deactivate {name}', {name: account.effectiveName}) }}</button>
    </form>
</section>
{%- endif %}
{%- if phone %}
<section class="admin-panel" aria-labelledby="people-phone-title">
    <h2 id="people-phone-title">{{ t('Remove mobile number') }}</h2>
    <p>{{ t('If {name} lost their phone or changed number, remove it here. They then add their new number on My account. Until then they can’t confirm important changes.', {name: account.effectiveName}) }}</p>
    <form action="{{ path }}/phone" method="post">
        {{ csrf_fields() }}
        <button type="submit" class="button button--secondary">{{ t('Remove the mobile number of {name}', {name: account.effectiveName}) }}</button>
    </form>
</section>
{%- endif %}
{%- endif %}
{% endblock %}
