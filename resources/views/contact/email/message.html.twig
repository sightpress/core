<!DOCTYPE html>
<html lang="{{ current_locale() }}" dir="{{ text_direction(current_locale()) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 1.5rem; font-family: system-ui, sans-serif; font-size: 18px; line-height: 1.5; color: #1a1a1a; background: #ffffff;">
<p>{{ t('{name} sent a message with the contact form on {page}.', {'name': name, 'page': page_title}) }} <a href="{{ page_url }}" style="color: #0b4f9c;">{{ t('Open the page') }}</a></p>
<p>{{ t('Reply to this email to answer them at {email}.', {'email': email}) }}</p>
<hr>
{% for paragraph in message|split("\n\n") %}
<p>{{ paragraph|nl2br }}</p>
{% endfor %}
</body>
</html>
