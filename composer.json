{
  "name": "sightpress/core",
  "description": "The core of SightPress, a powerful multi-site, multilingual CMS for everyone, designed with blind and low-vision creators and audiences in mind. Built on modern, object-oriented PHP.",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "keywords": ["cms", "accessibility", "a11y", "wcag", "multi-site", "multilingual"],
  "homepage": "https://sightpress.org",
  "support": {
    "issues": "https://github.com/sightpress/core/issues",
    "source": "https://github.com/sightpress/core"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../module-interface",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": ">=8.5",
    "composer/semver": "^3",
    "doctrine/dbal": "^4",
    "doctrine/migrations": "^3",
    "monolog/monolog": "^3",
    "nyholm/psr7": "^1",
    "nyholm/psr7-server": "^1",
    "php-di/php-di": "^7",
    "psr/event-dispatcher": "^1",
    "sightpress/module-interface": "^0.1",
    "slim/slim": "^4",
    "symfony/console": "^8"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phpstan/extension-installer": "^1",
    "phpstan/phpstan": "^2",
    "phpstan/phpstan-doctrine": "^2",
    "phpstan/phpstan-phpunit": "^2",
    "phpstan/phpstan-strict-rules": "^2",
    "phpunit/phpunit": "^13",
    "rector/rector": "^2"
  },
  "autoload": {
    "psr-4": {
      "SightPress\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SightPress\\Core\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "cs-check": "php-cs-fixer check --diff",
    "cs-fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse --no-progress",
    "rector": "rector process",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:coverage": "@php tools/coverage-check.php",
    "check": [
      "@composer validate --strict --no-check-lock",
      "@cs-check",
      "@phpstan",
      "@test:coverage",
      "@test:integration"
    ],
    "fix": [
      "@rector",
      "@cs-fix"
    ],
    "a11y": [
      "Composer\\Config::disableProcessTimeout",
      "npx --no-install playwright test"
    ]
  },
  "scripts-descriptions": {
    "cs-check": "Check the code style (PSR-12) without changing files.",
    "cs-fix": "Fix the code style (PSR-12).",
    "phpstan": "Run static analysis (PHPStan, level max).",
    "rector": "Apply automated refactorings (PHP 8.5 set).",
    "test": "Run the unit and integration test suites.",
    "test:unit": "Run the unit test suite.",
    "test:integration": "Run the integration test suite (SQLite in memory).",
    "test:coverage": "Run the unit suite with coverage; fail below 100% lines or methods or on any coverage ignore annotation.",
    "check": "Run every check that must pass before a commit.",
    "fix": "Apply Rector refactorings, then fix the code style.",
    "a11y": "Scan the skeleton's pages with Playwright and axe-core (WCAG 2.2 AA); needs `docker compose up` in ../skeleton."
  }
}
